main.app
  section.hero
    p.eyebrow Іграшковий Diffie-Hellman
    h1 Циферблат на 23 поділки
    p.lead
      | У справжньому протоколі число величезне, а тут беремо маленьке просте число 
      strong 23
      |  і крок 
      strong ×5
      | . Рух вперед рахувати легко, а от за позицією відновити кількість кроків - це дискретний логарифм.

  section.public-rules(aria-label="Публічні параметри")
    .rule
      span.label Публічно
      strong p = 23
      span циферблат
    .rule
      span.label Публічно
      strong g = 5
      span множник кроку
    .rule
      span.label Старт
      strong 1
      span перша позиція

  section.demo-grid
    include components/dial.pug

    .party-grid
      include components/alice-card.pug
      include components/bob-card.pug

  section.shared-result(aria-live="polite")
    p#sharedStatus Спочатку доведіть Алісу до 6 кроків, а Колю до 15.
    button#resetButton(type="button") Скинути демо
