{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "playground:js": "node js-core/index.js",
    "playground:js:watch": "node --watch js-core/index.js",
    "playground:ts": "tsx js-core/index.ts",
    "playground:ts:watch": "tsx --watch js-core/index.ts",
    "tsl:dev": "vite --config tsl-vizualization/vite.config.mts",
    "tsl:build": "vite build --config tsl-vizualization/vite.config.mts",
    "tsl:preview": "vite preview --config tsl-vizualization/vite.config.mts",
    "tsl:typecheck": "tsc --project tsl-vizualization/tsconfig.json",
    "svg:dev": "vite svg-example",
    "svg:build": "vite build svg-example",
    "svg:preview": "vite preview svg-example",
    "svg:typecheck": "tsc --project svg-example/tsconfig.json",
    "react:dev": "vite react-hello-world",
    "react:build": "vite build react-hello-world",
    "react:preview": "vite preview react-hello-world",
    "react:typecheck": "tsc --project react-hello-world/tsconfig.json"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.21"
  }
}
