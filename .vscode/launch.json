{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Express TS (dev tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/llm-visualizer-api",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "set -a && source ../../.env && set +a && source ~/.nvm/nvm.sh && nvm use 22.16.0 && npm run dev"
      ],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "React (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/llm-visualizer-web",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "source ~/.nvm/nvm.sh && nvm use 22.16.0 && npm run dev"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Playground JS Core",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/labs/playground/js-core/index.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Playground TS Core",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "js-core/index.ts"],
      "cwd": "${workspaceFolder}/labs/playground",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full app (Express + Vite)",
      "configurations": ["Express TS (dev tsx)", "React (Vite)"]
    }
  ]
}
