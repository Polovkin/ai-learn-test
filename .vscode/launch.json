{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Express API (tsx debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/llm-visualizer-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx",
        "src/index.ts"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Vite Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/llm-visualizer-web",
      "command": "npm run dev"
    },
    {
      "name": "Web (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/llm-visualizer-web/src"
    },
    {
      "name": "Playground JS Core",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/labs/playground/js-core/index.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Playground TS Core",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "js-core/index.ts"],
      "cwd": "${workspaceFolder}/labs/playground",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "JWT Learning Backend (Nest)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/authorization-authentication/backend",
      "command": "npm run start:dev"
    },
    {
      "name": "JWT Learning Frontend (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/authorization-authentication/frontend",
      "command": "npm run dev"
    }
  ],
  "compounds": [
    {
      "name": "Full app debug (Express + Vite)",
      "configurations": ["Express API (tsx debug)", "Vite Dev Server"]
    },
    {
      "name": "JWT Learning Full Stack (Backend + Frontend)",
      "configurations": [
        "JWT Learning Backend (Nest)",
        "JWT Learning Frontend (Vite)"
      ]
    }
  ]
}
