{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Express TS (dev tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "set -a && source ../.env && set +a && source ~/.nvm/nvm.sh && nvm use 22.16.0 && npm run dev"
      ],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "React (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "source ~/.nvm/nvm.sh && nvm use 22.16.0 && npm run dev"
      ],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full app (Express + Vite)",
      "configurations": ["Express TS (dev tsx)", "React (Vite)"]
    }
  ]
}
